{
  "name": "local-remote",
  "version": "0.4.0",
  "private": true,
  "main": "dist/electron.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc && npm run build:client",
    "build:client": "tsc -p tsconfig.client.json",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "tsc -p tsconfig.client.json --watch",
    "start": "node dist/server.js",
    "electron": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit && npm run typecheck:client",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@hurdlegroup/robotjs": "^0.12.3",
    "bonjour-service": "^1.4.4",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "de.localremote.app",
    "productName": "Local Remote",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/tray.ico"
    }
  }
}
